# Extension key — namespaces this extension on the host installation.
# Defaults to package.json#churchtools.extensionKey when unset; override here
# only if you need a unique suffix on a shared dev instance (e.g. rr-hikeplanner-pt).
VITE_KEY=rr-hikeplanner

# Local development against a real ChurchTools instance.
# Entwicklung/Tests IMMER gegen die Demo-Instanz (rr-demo), nie gegen live.
VITE_BASE_URL=https://your-instance.church.tools
VITE_USERNAME=
VITE_PASSWORD=

# Hajk-Vorlagengruppe und Ziel-Kalender dieser Instanz.
# Leer lassen = Live-Defaults aus src/wizard/config.ts (Vorlage 2587, Kalender 69).
# Auf der Demo-Instanz die IDs aus `npm run seed:demo` eintragen.
VITE_TEMPLATE_GROUP_ID=
VITE_CALENDAR_ID=

# Optional: where `npm run gen:types` reads the OpenAPI schema from.
CT_OPENAPI_URL=https://your-instance.church.tools/api/openapi.json
